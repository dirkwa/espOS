menu "espOS config store"

    config ESPOS_CONFIG_NVS_PARTITION
        string "NVS partition label"
        default "nvs"
        help
            Label of the NVS partition holding the configuration store.

    config ESPOS_CONFIG_MAX_MIGRATIONS
        int "Maximum registered migration steps"
        default 16
        range 1 128

    config ESPOS_CONFIG_MAX_SUBSCRIBERS
        int "Maximum change subscribers"
        default 8
        range 1 32

    config ESPOS_CONFIG_MAX_RUNTIME_NS
        int "Maximum runtime-registered namespaces"
        default 32
        range 0 128
        help
            Slots for namespaces registered at run time with
            espos_config_register_ns() — one per graph node that owns
            settings. Each costs one pointer plus an open NVS handle; the
            limit exists so the table is fixed-size like every other in
            espOS. Registration past this fails loudly (health condition
            flowConfig), it never silently drops a node's settings.

endmenu
