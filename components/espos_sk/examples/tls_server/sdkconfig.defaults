#
# The TLS transports for the SignalK stack: https for the access-request and
# REST calls, wss for the delta stream. Compiling them pulls the Mozilla root
# bundle into flash (about 64 KB in this example; a firmware that links it
# already pays nothing more); using them costs about 20 KB of RAM per open
# connection. This only makes the sk.tls setting *work* -- the device talks
# http/ws until it is set.
CONFIG_ESPOS_SK_TLS=y
