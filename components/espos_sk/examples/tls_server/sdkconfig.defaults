#
# Nothing to set: CONFIG_ESPOS_SK_TLS is on in sdkconfig.d/espos.defaults, and
# sk.scheme = auto / sk.tls_trust = tofu are the defaults too. The line that
# used to be here (CONFIG_ESPOS_SK_TLS=y) is now what every espOS firmware
# gets, which is the point of this example being uneventful.
#
# Restated here anyway, because it is the one setting this example is about
# and a reader looking for it should find it saying yes rather than nothing.
CONFIG_ESPOS_SK_TLS=y
