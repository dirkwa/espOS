menu "espOS HTTP server"

    config ESPOS_HTTPD_MAX_BODY
        int "Maximum request body size (bytes)"
        default 16384
        range 1024 262144
        help
            Requests with a larger Content-Length are rejected with 413.

    config ESPOS_HTTPD_STACK_SIZE
        int "Server task stack size (bytes)"
        default 8192
        range 4096 32768

    config ESPOS_HTTPD_TASK_PRIORITY
        int "Server task priority"
        default 5
        range 1 24

    config ESPOS_HTTPD_MAX_URI_HANDLERS
        int "Maximum number of URI handlers"
        default 64
        range 8 128

    config ESPOS_HTTPD_SSE_MAX_CLIENTS
        int "Maximum concurrent event-stream clients"
        default 3
        range 1 8
        help
            GET /api/v1/events keeps a socket open per client. The server's
            socket budget is 4 + this value, clamped to
            CONFIG_LWIP_MAX_SOCKETS - 3 (raise LWIP_MAX_SOCKETS for more).

    config ESPOS_HTTPD_SSE_PING_S
        int "Event-stream keepalive interval (s)"
        default 15
        range 5 120

    config ESPOS_HTTPD_WWW_DIR
        string "Mount point of the UI storage partition"
        default "/www"
        help
            The LittleFS "storage" partition holding the gzipped UI bundle
            is mounted here and served at /.

    config ESPOS_HTTPD_DEBUG_CRASH
        bool "Expose POST /api/v1/system/crash (deliberate panic, for testing core dumps)"
        default n

endmenu
