#
# Only what differs from espOS. cmake/espos_project.cmake puts
# sdkconfig.d/espos.defaults (+ .<target>) on SDKCONFIG_DEFAULTS ahead of this
# file, so flash/OTA/signing, logging, the HTTP server and the task stacks are
# inherited and a line here is an override, never a mirror. Defaults reach a
# FRESH sdkconfig only: delete build*/sdkconfig after changing anything here
# or in espOS's fragments.
#
# The flash size is NOT set here, unlike in the standalone repository this
# example came from: that project carried its own partition table and a
# project table has to state its own size, while partitions/16mb.csv (passed
# by the prologue) sets it.

# Largest inbound SignalK stream frame. espOS's default is 16 KiB; the
# gateway has had 64 KiB since its first release and a build-glue change is
# not the place to lower it. The buffer grows on demand, so the gateway's
# idle stream (it subscribes to nothing) pays nothing for the headroom.
CONFIG_ESPOS_SK_RX_FRAME_MAX=65536

# --- BLE (this project's reason for existing) --------------------------
# Bluedroid, not NimBLE: the GATT client is Bluedroid-based. Targets with a
# native radio use their own controller; the P4 overrides this to route HCI
# at the C6 co-processor (see sdkconfig.defaults.esp32p4).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y

# BLE 4.2, not 5.0. On the P4 the C6 slave's HCI bridge does not correctly
# forward BLE 5.0 extended HCI commands over SDIO, and legacy scan is the
# known-working path (the same choice ESPHome's bluetooth_proxy makes).
# Kept uniform across targets so behaviour does not diverge per board.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n
CONFIG_BT_BTU_TASK_STACK_SIZE=8192
