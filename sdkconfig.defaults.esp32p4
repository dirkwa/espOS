# ESP32-P4: WiFi via ESP32-C6 co-processor over SDIO (esp_hosted +
# esp_wifi_remote). Pinout below is the Waveshare ESP32-P4-WIFI6-Touch-LCD
# family (7B / 4B): SDIO slot 1, CLK 18, CMD 19, D0..D3 14..17, C6 reset on
# GPIO 54 (active high). Adjust for other P4 boards.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
# The Waveshare panels ship 16 MB flash; the shared partitions.csv assumes 4 MB
# and still fits — keep it until a P4-specific table is needed.
# The Waveshare panels carry ESP32-P4 rev v1.x silicon; IDF 6 defaults to
# the v3.x mass-production revision. Allow the older revision.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_FREERTOS_HZ=1000

# esp_hosted's startup allocations nearly fill RETENT_RAM before the main
# task exists; a 3.5 KB main stack could then land in the 7 KB SPM/TCM
# region, where the first flash access asserts (cache_utils.c
# esp_task_stack_is_sane_cache_disabled). A stack larger than SPM cannot.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Receive block-ack window for the remote (C6) radio. IDF defaults this to
# 6, but silently raises it to 16 as soon as a project enables PSRAM
# (SPIRAM_TRY_ALLOCATE_WIFI_LWIP) — which any board with a display will.
# A window of 16 overruns the SDIO Rx path on this transport: it wedges
# under sustained inbound TCP, spamming "H_SDIO_DRV: task still writing Rx
# data to queue!" while every RPC to the C6 times out. WiFi then stays
# dead until the host reboots, and the WiFi state machine still reports
# CONNECTED because the disconnect event never crosses the jammed link
# (espressif/esp-hosted-mcu#184).
#
# Measured on a Waveshare 7B with repeated ~30 KB HTTP reads: at 16 the
# link wedged after 85 requests / 77 s; at 6 it survived 400 consecutive
# requests over 283 s. Pin it explicitly so enabling PSRAM downstream
# cannot silently reintroduce the fault.
#
# Note the knob is WIFI_RMT_* (esp_wifi_remote): with hosted WiFi the
# radio is remote, so the local ESP_WIFI_RX_BA_WIN has no effect on it.
# esp_hosted's SDIO RX buffers are 64-byte-aligned DMA allocations that grow to
# fit the largest frame seen. Without this they come from
# MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA — a far tighter pool than plain internal
# RAM, and one nothing routinely measures. On a P4 panel a 9216-byte request
# failed while the usual internal-RAM metric still read a healthy 26 KB:
#
#   W H_SDIO_DRV: RX buffer alloc failed (len=9216); dropping read
#
# The co-processor link then died, its heartbeat stopped, and the device
# restarted roughly a minute later on a 6-20 minute cycle.
#
# The P4's GDMA reaches PSRAM through cache (SOC_PSRAM_DMA_CAPABLE=1), which is
# the case this option exists for. hosted_malloc_align() tries DMA-capable
# SPIRAM first and still falls back to internal RAM, so it degrades rather than
# breaks. Do NOT set this on a target whose DMA cannot reach PSRAM.
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

CONFIG_WIFI_RMT_RX_BA_WIN=6

# Streaming mode must stay ON: the C6 slave firmware is fixed in streaming
# mode and the host has to match, or the transport asserts at boot —
# "SDIO mode mismatch: slave is in streaming mode, but host is in packet
# mode. Aborting." (transport_drv.c). Do not "optimise" this to RX_NONE
# without building a matching slave.
